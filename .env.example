# NEXORA — Environment Variables (Placeholders Only)
# Never commit .env or .env.local with real credentials.
# Never prefix secret keys with NEXT_PUBLIC_.

# Runtime server settings
PORT=3000
HOSTNAME=0.0.0.0

# Public application URL (non-secret)
NEXT_PUBLIC_APP_URL=http://localhost:3000

